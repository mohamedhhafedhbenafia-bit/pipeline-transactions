# Copier en .env et adapter (surtout en production : changer les mots de passe !)
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=transactions
PG_PORT=5433

S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=pipeline-secret
S3_BUCKET=transactions
S3_PREFIX=incoming/
S3_PORT=8333

DASHBOARD_PORT=8501
SCHEDULE_INTERVAL=30
# Image publiée par la CD (sinon construite localement)
# APP_IMAGE=ghcr.io/<utilisateur>/pipeline-transactions:latest

# Paramètres de la pipeline (côté Python, hors conteneurs)
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5433/transactions
S3_ENDPOINT_URL=http://localhost:8333
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
# Simulation de pannes (nombre d'échecs par fichier)
FAIL_INSERT_TIMES=0
FAIL_DOWNLOAD_TIMES=0
